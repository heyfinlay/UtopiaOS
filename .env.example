# Local web -> API connection. Leave unset on Vercel so the web app uses same-origin /api.
VITE_API_URL=http://localhost:8787

# Local API server.
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Supabase persistence. Required for durable Vercel deployments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UTOPIA_OWNER_ID=

# Optional browser-side Supabase values for future auth work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional live agent bridge. Leave blank for mock mode.
OPENCLAW_COMMAND=
