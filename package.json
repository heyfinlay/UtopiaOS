  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@supabase/supabase-js": "^2.105.1",
    "@utopia/agent-actions": "workspace:*",
    "@utopia/db": "workspace:*",
    "@utopia/schemas": "workspace:*",
    "hono": "^4.12.15",
    "zod": "^4.4.1"
  }
