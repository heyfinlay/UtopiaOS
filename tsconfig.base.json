{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@utopia/schemas": ["packages/schemas/src/index.ts"],
      "@utopia/db": ["packages/db/src/index.ts"],
      "@utopia/agent-actions": ["packages/agent-actions/src/index.ts"]
    }
  }
}
